#!name=G1 ACQ SKU Quản Lý (v9.5 Tiếng Việt - Chống Trùng ID)
#!desc=Bản v9.5 Tiếng Việt: Sửa lỗi trùng ID 4 nút 2TB gây báo "Giao dịch mua chưa hoàn tất" và mở rộng bắt mọi đường dẫn /ai, /u/0/ai, /plans. Mở Safari vào https://one.google.com/g1-sku-report để chọn bộ test.
#!system=ios

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/tmq9999/quangtesst/main/g1-acq-discount.js?v=9500
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/tmq9999/quangtesst/main/g1-sku-report-discount.js?v=9500

[MITM]
hostname = %APPEND% one.google.com
