#!name=G1 ACQ SKU Quản Lý (crhywun v7.13.0 Tiếng Việt + Ultra Presets)
#!desc=Bản gốc crhywun/g1-acq v7.13.0 đã Việt hóa 100%: Không chèn HTML vào one.google.com/ai (chống lỗi 502/WIZ). Đổi bộ SKU Ultra 20TB/30TB bằng cách mở Safari vào https://one.google.com/g1-sku-report rồi bấm "Áp dụng mẫu".
#!system=ios

[Rule]
# Chặn UDP 443 để ép HTTP/3 (QUIC) hạ xuống TCP giúp Shadowrocket giải mã MITM ổn định, tránh lỗi 502.
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/tmq9999/quangtesst/main/g1-acq.js?v=7130
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/tmq9999/quangtesst/main/g1-sku-report.js?v=7130

[MITM]
hostname = %APPEND% one.google.com
