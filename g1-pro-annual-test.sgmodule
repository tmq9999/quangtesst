#!name=G1 Pro Annual Test
#!desc=v7.10.0 SKU管理兼容入口：引用g1-acq-v7.10-mappings；本机报告新增土区旧30TB历史2949.99里拉、Ultra三个月75p、2TB/Pro12个月90p三套模板，点击直接合并保存，同match/from更新启用并保留ID与其他规则，超过30条整批失败，下一次 /ai? 响应使用配置；保留手动增删改、启停与恢复默认，默认discount75仍为20TB/30TB三个月75p与2TB目标g1.2tb.ai.12months_ip_90p（无 .acq），模板或手动保存为custom，fallback=false；土区仅公开历史报价，金额周期按App Store显示；保留 /ai? 匹配范围、最近10次响应与schema1；主入口为G1 ACQ SKU 管理，只开启一个改写入口
#!system=ios

[Rule]
# 与旧模块相同：拦截 UDP 443，作用于使用该配置的流量。
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-pro-annual-test = type=http-response,pattern=^https:\/\/one\.google\.com\/ai\?,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.11.0/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.11.0/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
