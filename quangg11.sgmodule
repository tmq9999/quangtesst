#!name=G1 ACQ Ultra (v10 Clean)
#!desc=Thay thế thuần túy mã SKU Google AI Ultra trên /ai? (không chèn HTML chống lỗi xoay vòng); đổi bộ mã tại Safari: https://one.google.com/g1-sku-report
#!system=ios

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://raw.githubusercontent.com/tmq9999/quangtesst/main/quangg11.js?v=10
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/(?:u\/\d+\/)?ai\?,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/tmq9999/quangtesst/main/quangg11.js?v=10

[MITM]
hostname = %APPEND% one.google.com
