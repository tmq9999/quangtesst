#!name=G1 ACQ SKU Quản Lý (v9.6.0 Tiếng Việt - Chuẩn Hóa Mã Sống)
#!desc=Bản v9.6.0 Tiếng Việt: Mặc định chỉ bật 1 rule duy nhất g1.ios.20tb.m.v2 -> com.google.gemini.2tb.ai.m.3month_ip_99p (mở gói Google AI Pro 5 TB giảm 99%), kèm Ultra 20TB/30TB giá cũ. Quản lý tại https://one.google.com/g1-sku-report
#!system=ios

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/tmq9999/quangtesst/main/g1-acq-discount.js?v=9600
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/tmq9999/quangtesst/main/g1-sku-report-discount.js?v=9600

[MITM]
hostname = %APPEND% one.google.com
