#!name=G1 ACQ SKU Quản Lý (crhywun v7.12.0 Tiếng Việt)
#!desc=Bản v7.12.0 Tiếng Việt: Gồm 3 bộ CHẮC CHẮN LÊN BẢNG GIÁ (Ultra 20TB/30TB mã gốc g1.ios.20tb.m / 30tb.m và Pro giảm 99% com.google.gemini.2tb.ai.m.3month_ip_99p). Mở Safari vào https://one.google.com/g1-sku-report để chọn.
#!system=ios

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/tmq9999/quangtesst/main/g1-acq-discount.js?v=7120
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/tmq9999/quangtesst/main/g1-sku-report-discount.js?v=7120

[MITM]
hostname = %APPEND% one.google.com
